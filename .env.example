# Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional fallback for the deposit address. The app normally reads it from the
# backend (RECEIVING_WALLET below), so the two can never disagree.
# VITE_PLATFORM_WALLET=0xYourPlatformWalletAddress

# Convex environment variables (set via `npx convex env set`)
# RECEIVING_WALLET=0xDepositAddressUsersSendUSDCTo
# PLATFORM_PRIVATE_KEY=0xKeyOfTheWalletThatPaysWithdrawals   (needs USDC + a little ETH on Base)
# BASE_RPC_URL=https://your-base-rpc   (optional; defaults to the public RPC)
# NEYNAR_API_KEY=your-neynar-api-key  # for Farcaster Frame validation

# Frontend origin, shown in the wallet sign-in message
# FRONTEND_URL=https://your-app.vercel.app
