# Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Platform wallet that receives USDC escrow payments from posters
VITE_PLATFORM_WALLET=0xYourPlatformWalletAddress

# Convex environment variables (set via `npx convex env set`)
# RECEIVING_WALLET=0xYourWalletAddressThatReceivesUSDC
# PLATFORM_PRIVATE_KEY=0xYourPlatformWalletPrivateKey
# NEYNAR_API_KEY=your-neynar-api-key  # for Farcaster Frame validation

# Frontend (production, for Convex CORS)
# FRONTEND_URL=https://your-app.vercel.app
